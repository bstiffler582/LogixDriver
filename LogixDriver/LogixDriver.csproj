<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Logix</RootNamespace>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>LogixDriver</PackageId>
    <AssemblyVersion>0.1.7</AssemblyVersion>
    <Version>$(AssemblyVersion)</Version>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <PackageOutputPath>../release</PackageOutputPath>
    <PackageProjectUrl>https://github.com/bstiffler582/LogixDriver</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="ConsoleTest\**" />
    <EmbeddedResource Remove="ConsoleTest\**" />
    <None Remove="ConsoleTest\**" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="libplctag" Version="1.5.2" />
  </ItemGroup>

</Project>
